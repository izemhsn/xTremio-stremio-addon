# Copy this file to .env and fill it in:
#   cp .env.example .env
# Never commit .env — it holds your secret. (.gitignore already skips it.)
# Every setting is explained in the "Settings" section of README.md.

# REQUIRED. Key that encrypts install links. Generate it once and keep it:
#   openssl rand -base64 48
# Changing or losing it breaks every existing install link.
CONFIG_SECRET=

# Optional. Your public https:// address, when the addon runs on a server.
# PUBLIC_URL=https://xtremio.example.com

# Optional. Set to true when nginx / Caddy / Traefik sits in front of the addon.
# TRUST_PROXY=true

# Optional. Log every meta and stream request (handy while debugging).
# LOG_REQUESTS=true
